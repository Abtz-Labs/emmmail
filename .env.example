# Emmmail environment configuration
# Generated on first run — do not commit to version control

# Encryption key for stored IMAP/SMTP passwords (64-char hex, auto-generated)
EMMMAIL_KEY=

# Optional: database file path (default: ./emmmail.sqlite)
# EMMMAIL_DB=

# Optional: attachments directory (default: ./attachments)
# EMMMAIL_ATTACHMENTS=

# Optional: sync interval hint for UI (does not affect cron)
# EMMMAIL_SYNC_INTERVAL=60
